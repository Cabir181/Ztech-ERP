# ---------------------------------------------------------------------------
# Ztech Sales - environment template
#
# Copy to .env and fill in. This file is committed; .env never is.
# There are NO real credentials here and none should ever be added.
# Every value below is read at process start; nothing is baked into the image,
# so the same tagged build serves every client.
# ---------------------------------------------------------------------------

# Identifies this client deployment. Namespaces the private attachment
# directory and appears in every log line. One code per client.
CLIENT_CODE=local

# ---------------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------------
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=replace-me-with-a-generated-secret
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_DEBUG=true
DJANGO_LOG_LEVEL=INFO

# Hostnames this deployment answers on, comma separated.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Browser origins, comma separated, including the scheme. Required in
# production; must be https there.
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:8000

# ---------------------------------------------------------------------------
# PostgreSQL 16
# ---------------------------------------------------------------------------
POSTGRES_DB=ztech_sales
POSTGRES_USER=ztech
POSTGRES_PASSWORD=replace-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60

# ---------------------------------------------------------------------------
# Private attachment storage
# ---------------------------------------------------------------------------
# Attachments are stored under PRIVATE_STORAGE_ROOT/CLIENT_CODE/ and are served
# only through a permission-checked download view. This path must NOT be inside
# any directory the web server publishes.
PRIVATE_STORAGE_ROOT=/var/lib/ztech-sales/private
MAX_UPLOAD_BYTES=26214400

# ---------------------------------------------------------------------------
# Attachment scanning
# ---------------------------------------------------------------------------
# "stub" accepts uploads WITHOUT scanning them and is refused by the production
# settings module. Configure a real scan service before going live.
ATTACHMENT_SCANNER=stub
ATTACHMENT_SCANNER_URL=

# ---------------------------------------------------------------------------
# Outbound email
# ---------------------------------------------------------------------------
# Leaving EMAIL_HOST empty is a supported state: the application reports email
# as "not configured" and refuses to queue customer messages. It never reports
# a message as sent when nothing can be delivered.
# For local development, docker compose starts Mailpit on smtp host "mail"
# port 1025 with its inbox at http://localhost:8025.
EMAIL_HOST=
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=30
DEFAULT_FROM_EMAIL=

# ---------------------------------------------------------------------------
# Sessions and sign-in
# ---------------------------------------------------------------------------
SESSION_COOKIE_AGE=43200
PASSWORD_MIN_LENGTH=12
LOGIN_MAX_FAILED_ATTEMPTS=10
LOGIN_LOCKOUT_SECONDS=900

# ---------------------------------------------------------------------------
# One-time administrator creation
# ---------------------------------------------------------------------------
# Read by `manage.py create_admin` so the password never appears in shell
# history or in a process listing. Unset it again once the account exists.
ZTECH_ADMIN_PASSWORD=
